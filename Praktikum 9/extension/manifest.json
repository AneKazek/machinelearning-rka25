{
  "manifest_version": 3,
  "name": "Pac-Man RL Demo",
  "version": "1.0.0",
  "description": "Plays FreePacman with a Q-learning policy trained locally.",
  "content_scripts": [
    {
      "matches": ["https://freepacman.org/*"],
      "js": ["autoplay.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["policy.json"],
      "matches": ["https://freepacman.org/*"]
    }
  ]
}
